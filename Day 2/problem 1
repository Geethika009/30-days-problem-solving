/*💻 DSA — Problem 4

Given an integer array nums, find the number of continuous subarrays whose sum equals k.

Example
nums = [1, 1, 1]
k = 2

Output: 2

The valid subarrays are:

[1,1]
[1,1]

Another example:

nums = [1,2,3]
k = 3

Output: 2

Because:

[1,2]
[3]
Constraints
1 <= nums.length <= 20000
-1000 <= nums[i] <= 1000
-10^7 <= k <= 10^7*/


import java.util.*;

public class Main {

    public static int subarraySum(int[] arr, int k) {
      HashMap<Integer, Integer> map = new HashMap<>();
      map.put(0,1);
      int count = 0;
      int sum = 0;
      for(int num : arr){
        sum += num;
        if(map.containsKey(sum - k)){
          count += map.get(sum - k);

        }
        map.put(sum, map.getOrDefault(sum, 0)+1);
      }

        return count;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int result = subarraySum(arr, k);

        System.out.println(result);

        sc.close();
    }
}
