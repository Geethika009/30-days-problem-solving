Given an integer array nums, return the maximum sum of a non-empty subsequence such that no two selected elements are adjacent in the original array.

Example
Input:  nums = [2, 7, 9, 3, 1]
Output: 12

Explanation:

2 + 9 + 1 = 12
Constraints
1 <= nums.length <= 100000
-10000 <= nums[i] <= 10000

Your task: Return the maximum possible sum.



import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      int[] arr = new int[n];
      for(int i=0; i<n; i++){
        arr[i] = sc.nextInt();
      }
      if(arr.length == 1){
        System.out.print(arr[0]);
      }
      
      int[] dp = new int[n];
      dp[0] = arr[0];
      dp[1] = Math.max(arr[0], arr[1]);
      for(int i=2; i<n; i++){
        dp[i] = Math.max(dp[i-2]+arr[i], dp[i-1]);
      }
      System.out.print(dp[n-1]);
    }
}
